{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FivePRS/registry/master/schema/partner.schema.json",
  "title": "FivePRS partner",
  "description": "One partner shown on fiveprs.org/partners.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "summary", "logo"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "Unique id. Must match the file name.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,48}[a-z0-9])$"
    },
    "name": {
      "description": "Display name.",
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "type": {
      "description": "community: a server or roleplay community running FivePRS. host: a server host offering FivePRS. studio: a developer or team making FivePRS assets.",
      "enum": ["community", "host", "studio"]
    },
    "summary": {
      "description": "One or two sentences shown on the partner card.",
      "type": "string",
      "minLength": 20,
      "maxLength": 200
    },
    "logo": {
      "description": "A square logo hosted on GitHub: raw.githubusercontent.com or github.com/user-attachments.",
      "type": "string",
      "pattern": "^https://(raw\\.githubusercontent\\.com/|github\\.com/user-attachments/assets/)"
    },
    "website": {
      "description": "Your website.",
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "discord": {
      "description": "A permanent Discord invite link.",
      "type": "string",
      "pattern": "^https://(discord\\.gg|discord\\.com/invite)/[A-Za-z0-9-]{2,32}$"
    },
    "github": {
      "description": "Your GitHub user or organisation name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
    },
    "tags": {
      "description": "Up to 6 lowercase tags, such as a region, language or roleplay style.",
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
      }
    },
    "joinCode": {
      "description": "Communities: the code from your cfx.re/join link.",
      "type": "string",
      "pattern": "^[a-z0-9]{6}$"
    },
    "offer": {
      "description": "Hosts: a short offer for FivePRS users, such as a discount code.",
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "assets": {
      "description": "Studios: ids of your listings in listings/.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "community" } } },
      "then": { "required": ["joinCode"], "not": { "anyOf": [{ "required": ["offer"] }, { "required": ["assets"] }] } }
    },
    {
      "if": { "properties": { "type": { "const": "host" } } },
      "then": { "required": ["website"], "not": { "anyOf": [{ "required": ["joinCode"] }, { "required": ["assets"] }] } }
    },
    {
      "if": { "properties": { "type": { "const": "studio" } } },
      "then": { "required": ["assets"], "not": { "anyOf": [{ "required": ["joinCode"] }, { "required": ["offer"] }] } }
    }
  ]
}
